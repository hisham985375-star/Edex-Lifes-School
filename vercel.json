{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "https://admission.edexlifeschool.com/",
      "permanent": false
    },
    {
      "source": "/habit-tracker",
      "destination": "https://edex-habit-tracker.vercel.app/",
      "permanent": false
    },
    {
      "source": "/curriculum",
      "destination": "/curiculam",
      "permanent": true
    },
    {
      "source": "/curiculum",
      "destination": "/curiculam",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
